# Generated by urmaild. DO NOT EDIT.
compatibility_level = 3.6

# Network & Host identity
myhostname = box.urmail.cn
mydomain = urmail.cn
myorigin = $mydomain
mydestination =
inet_interfaces = all
inet_protocols = all

# SMTP Banner
smtpd_banner = $myhostname ESMTP urmail
biff = no
append_dot_mydomain = no
recipient_delimiter = +

message_size_limit = 10240000

# Virtual domains, mailboxes and aliases
virtual_mailbox_domains = tenant-a.com, tenant-b.net, tenant-c.org
virtual_mailbox_base = /var/mail/mail/mailboxes
virtual_mailbox_maps = hash:/etc/postfix/urmail/virtual_mailbox.map
virtual_alias_maps = hash:/etc/postfix/urmail/virtual_alias.map
virtual_transport = lmtp:unix:private/dovecot-lmtp

# SASL Authentication (Dovecot)
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes

# Abuse & resource limits (MAIL-003), enforced by anvil
anvil_rate_time_unit = 60s
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_auth_rate_limit = 15
smtpd_client_message_rate_limit = 120
smtpd_client_recipient_rate_limit = 240
smtpd_error_sleep_time = 5s
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10

# DKIM signing through OpenDKIM on loopback. If the milter is down,
# accept the message unsigned instead of blocking mail delivery.
milter_default_action = accept
milter_protocol = 6
header_checks = regexp:/etc/postfix/urmail/spam-header-checks
smtpd_milters = inet:127.0.0.1:12301, inet:127.0.0.1:11339
non_smtpd_milters = inet:127.0.0.1:12301

# Sender login restrictions
smtpd_sender_login_maps = hash:/etc/postfix/urmail/sender_login.map
smtpd_sender_restrictions =
    reject_authenticated_sender_login_mismatch
    permit_mynetworks
    reject_sender_login_mismatch

# Recipient & Relay restrictions
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions =
    permit_sasl_authenticated
    permit_mynetworks
    reject_unauth_destination
    reject_non_fqdn_recipient

# TLS Settings
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_exclude_ciphers = aNULL, RC4, 3DES
smtpd_tls_cert_file = /var/mail/ssl/box.urmail.cn.cert
smtpd_tls_key_file = /var/mail/ssl/box.urmail.cn.key
smtp_tls_security_level = may
smtp_tls_loglevel = 1
