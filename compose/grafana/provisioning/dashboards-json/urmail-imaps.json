   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "urmail_dovecot_auth_snapshot_staleness_seconds"
    }
   ]
  },
  {
   "type": "row",
   "title": "R3 容器资源",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "table",
   "title": "R3 cAdvisor 二期暂缓",
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vector(1)",
     "instant": true,
