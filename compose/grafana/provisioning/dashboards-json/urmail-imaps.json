{
 "uid": "urmail-imaps",
 "title": "urmail · IMAPS 会话",
 "timezone": "Asia/Shanghai",
 "tags": [
  "urmail",
  "phase4"
 ],
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "urmail_operational_condition",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_operational_condition)",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "urmail_database_reachable",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_database_reachable)",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "urmail_dovecot_auth_snapshot_dirty",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_dovecot_auth_snapshot_dirty)",
     "instant": true
    }
   ]
  },
  {
   "type": "row",
   "title": "R1 会话",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "IMAPS 会话成功率 (30m)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(urmail_probe_imaps_success[30m]))",
     "instant": true
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "IMAPS 探针时延",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "urmail_probe_imaps_duration_seconds"
    }
   ]
  },
  {
   "type": "row",
   "title": "R2 auth snapshot",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "auth snapshot dirty",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_dovecot_auth_snapshot_dirty)"
    }
   ]
  },
  {
