{
 "uid": "urmail-queue",
 "title": "urmail · 队列（P95/单调增长）",
 "timezone": "Asia/Shanghai",
 "tags": [
  "urmail",
  "phase4"
 ],
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "urmail_operational_condition",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_operational_condition)",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "urmail_database_reachable",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_database_reachable)",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "urmail_dovecot_auth_snapshot_dirty",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_dovecot_auth_snapshot_dirty)",
     "instant": true
    }
   ]
  },
  {
   "type": "row",
   "title": "R1 深度",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "队列深度",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "urmail_postfix_queue_depth"
    }
   ]
  },
  {
   "type": "row",
   "title": "R2 60min 单调性",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "timeseries",
   "title": "60min 增量",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(urmail_postfix_queue_depth[60m])"
    }
   ]
  },
  {
   "type": "row",
   "title": "R3 deferred",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "table",
   "title": "探针 deferred 明细",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "urmail_postfix_queue_depth",
     "instant": true,
     "format": "table"
    }
   ]
  }
 ]
}