    "x": 0,
    "y": 0,
    "w": 8,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "urmail-prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(urmail_operational_condition)",
     "instant": true
    }
   ]
