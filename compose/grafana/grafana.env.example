# GRAFANA-DESIGN §5 entry variables (compose env injection point; DevOps wires
# these into the grafana service environment). User decision 2026-11-27: the
# public monitoring entry is the SAME-SITE path https://<primary
# host>/dashboard — the deprecated grafana.<domain> subdomain must not be
# used.
URMAIL_GRAFANA_HOSTNAME=box.example.test
URMAIL_AUTH_PROXY_TARGET=

# Grafana service environment (compose grafana: environment:)
#   GF_SERVER_ROOT_URL=https://box.example.test/dashboard
#   GF_SERVER_SERVE_FROM_SUB_PATH=true        # Grafana emits /dashboard-prefixed URLs
#   GF_AUTH_PROXY_ENABLED=true
#   GF_AUTH_PROXY_HEADER_NAME=X-WEBAUTH-USER
#   GF_AUTH_PROXY_HEADERS=Name:X-WEBAUTH-USER;Role:X-WEBAUTH-ROLE
#   GF_AUTH_PROXY_WHITELIST=127.0.0.1         # only Caddy injects these headers
#   GF_USERS_ALLOW_SIGN_UP=false
#   GF_AUTH_ANONYMOUS_ENABLED=false
#   GF_AUTH_BASIC_ENABLED=false               # emergency channel only
#   GF_SECURITY_ADMIN_USER=admin
#   GF_SECURITY_ADMIN_PASSWORD=<Vault>
# Cookie isolation (pm-grafana-pathfix-1): Grafana session cookies
# (gf_session.*) land host-only on the primary host with different names than
# the urmail session cookies (urmail_panel_session on the parent domain),
# so no name collision or scope bleed exists; both sides run Secure +
# SameSite=Lax and urmaild ignores unknown cookie names on /api routes.
