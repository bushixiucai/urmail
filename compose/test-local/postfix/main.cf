# LOCAL TEST postfix main.cf (compose/test-local).  NOT a product config.
# The product config generator is not implemented on this branch; this file
# exists only to exercise the compose network/volume wiring end to end.
compatibility_level = 3.6
myhostname = mail.local.test
myorigin = $myhostname
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
smtpd_banner = $myhostname ESMTP urmail-phase2-local
maillog_file = /dev/stdout
biff = no
append_dot_mydomain = no
readme_directory = no

# TLS material is generated by the local harness into the data root.
smtpd_tls_cert_file = /etc/urmail/tls/cert.pem
smtpd_tls_key_file = /etc/urmail/tls/key.pem
smtpd_tls_security_level = none

# SASL delegated to dovecot over the compose network (test-only plaintext).
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = permit_sasl_authenticated, reject_unauth_destination

# Deliver local domain over LMTP to dovecot (Maildir).
virtual_mailbox_domains = local.test
virtual_mailbox_maps = texthash:/etc/postfix/vmailbox
virtual_transport = lmtp:inet:dovecot:24
virtual_minimum_uid = 5000
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000
message_size_limit = 25600000
