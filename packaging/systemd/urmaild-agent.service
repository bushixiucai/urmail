[Unit]
Description=urMail.cn privileged agent
Documentation=https://urmail.cn/docs
After=network.target

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/urmaild-agent
Restart=always
RestartSec=3s
EnvironmentFile=-/etc/urmail/urmaild.env

# The agent runs as root because it has to write system configuration and
# reload services. It has no network listener at all: it is reached only
# through a unix socket that is restricted to the mailinabox group.
RuntimeDirectory=urmail
RuntimeDirectoryMode=0750
UMask=0007

NoNewPrivileges=no
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native

ReadWritePaths=/etc/urmail /etc/postfix /etc/dovecot /etc/nginx /var/lib/urmail /run/urmail /var/mail

[Install]
WantedBy=multi-user.target
