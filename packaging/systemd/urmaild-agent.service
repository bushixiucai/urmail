[Unit]
Description=urMail.cn privileged agent
Documentation=https://urmail.cn/docs
After=network.target postgresql.service

[Service]
Type=exec
User=root
Group=mailinabox
ExecStartPre=/bin/chown root:mailinabox /run/urmail
ExecStartPre=/bin/chmod 0770 /run/urmail
ExecStart=/usr/bin/urmaild-agent
Restart=always
RestartSec=3s
EnvironmentFile=/etc/urmail/agent.env
Environment=URMAIL_ENV_FILE=/etc/urmail/agent.env

# The agent runs as root because it has to write system configuration and
# reload services. It has no network listener at all: it is reached only
# through a unix socket that is restricted to the mailinabox group.
#
# RuntimeDirectory, the explicit chown/chmod above and the server's chmod of
# the socket together guarantee /run/urmail is root:mailinabox 0770 and the
# socket is root:mailinabox 0660. urmaild runs as mailinabox and is the only
# unprivileged writer.
RuntimeDirectory=urmail
RuntimeDirectoryMode=0770
UMask=0022
StateDirectory=urmail-agent
StateDirectoryMode=0700

NoNewPrivileges=no
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native

ReadWritePaths=/var/spool/postfix /var/lib/postfix /etc/urmail /etc/postfix /etc/dovecot /etc/nginx /etc/nsd /etc/nsd/zones /etc/opendkim /etc/opendkim/keys /var/lib/urmail-agent /var/lib/urmail-acme /run/urmail /var/mail /etc/letsencrypt /var/log/letsencrypt

[Install]
WantedBy=multi-user.target
