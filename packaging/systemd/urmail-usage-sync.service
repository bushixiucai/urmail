[Unit]
Description=Collect mailbox storage usage
After=postgresql.service dovecot.service
[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/urmail/agent.env
Environment=URMAIL_ENV_FILE=/etc/urmail/agent.env
ExecStart=/usr/bin/urmailctl usage sync
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
