[Unit]
Description=urMail.cn management service
Documentation=https://urmail.cn/docs
After=network-online.target postgresql.service nginx.service
Wants=network-online.target
Requires=urmaild-agent.service

[Service]
Type=exec
User=mailinabox
Group=mailinabox
ExecStart=/usr/bin/urmaild
Restart=always
RestartSec=3s
EnvironmentFile=-/etc/urmail/urmaild.env

# The service talks to PostgreSQL, the privileged agent over a unix socket and
# nothing else. The sandbox below makes that explicit rather than implicit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/urmail /run/urmail

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
