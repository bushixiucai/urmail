# urMail compose skeleton environment (copy to .env and adjust).
# 数据布局遵循 ARCH-PLAN §1.2：单根 bind mount，迁移=拷目录。

# ---- 数据根（默认仓库旁 ./data；生产建议 /srv/urmail/data）
URMAIL_DATA_ROOT=./data

# ---- 主机身份（postfix myhostname / 证书域名基线）
URMAIL_MYHOSTNAME=urmail.local
# ---- 主域名（urmaild 生产模式必填）
URMAIL_PRIMARY_DOMAIN=urmail.local

# ---- 数据目录属主：urmaild/agent 以 uid 5000:5000 运行（QA P1-5），
#      安装侧需一次性 `chown -R 5000:5000 ${URMAIL_DATA_ROOT}`（install.sh 收口）。

# ---- PG 占位（Phase 1 SQLite 接入后 pg 服务与这些变量退役）
URMAIL_PG_USER=urmail
URMAIL_PG_DB=urmail
# generate: openssl rand -hex 24
URMAIL_PG_PASSWORD=change-me

# ---- 镜像版本串（§1.8：后续 upgrade.sh 会强制 = checkout 的 tag）
URMAIL_IMAGE_VERSION=snapshot

# ---- Caddyfile 渲染接线（§1.3）：留空=使用占位 Caddyfile（不可上生产）；
# 指向渲染命令后 install/upgrade 会执行它并 fail-closed（失败即中止）。
# URMAIL_CADDY_RENDER_CMD=docker compose run --rm urmaild urmailctl config render-caddy

# ---- 构建期代理（仅构建时需要；运行时不使用。留空=直连）
# COMPOSE_BUILD_https_proxy=http://192.168.1.20:6152
# COMPOSE_BUILD_http_proxy=http://192.168.1.20:6152
# 国内直连域名必须排除在代理外（goproxy.cn 走代理反而易断）
# COMPOSE_BUILD_no_proxy=goproxy.cn,.cn,localhost,127.0.0.1
